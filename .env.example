# Enquiry delivery (Resend). Copy to .env.local for local dev; on Vercel set these under Project > Settings > Environment Variables.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Optional. Defaults to "Nikunj Homes <onboarding@resend.dev>", which only delivers to your own Resend account email.
ENQUIRY_FROM_EMAIL=
